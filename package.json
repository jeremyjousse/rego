{
  "name": "rego-monorepo",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "homepage": "https://rego.jousse.fr/",
  "repository": {
    "url": "github:jeremyjousse/rego"
  },
  "scripts": {
    "dev": "pnpm --filter @rego/web dev",
    "build": "pnpm --filter @rego/web build",
    "preview": "pnpm --filter @rego/web preview",
    "check": "pnpm --filter @rego/domain typecheck && pnpm --filter @rego/web check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test",
    "desktop:dev": "pnpm --filter @rego/desktop dev",
    "desktop:build": "pnpm --filter @rego/desktop build",
    "desktop:ios": "pnpm --filter @rego/desktop ios"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "prettier": "^3.5.2",
    "prettier-plugin-svelte": "^3.3.3",
    "semantic-release": "^25.0.9",
    "typescript": "^5.7.3"
  }
}
