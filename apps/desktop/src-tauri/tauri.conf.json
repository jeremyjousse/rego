{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReGo",
  "version": "0.1.0",
  "identifier": "fr.jousse.rego",
  "build": {
    "beforeDevCommand": "pnpm --filter @rego/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @rego/web build",
    "frontendDist": "../../apps/web/build"
  },
  "app": {
    "windows": [
      {
        "title": "ReGo",
        "width": 900,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "DEVELOPMENT_TEAM"
    }
  }
}
